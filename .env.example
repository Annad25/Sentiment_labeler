# Primary provider (required)
OPENAI_API_KEY=sk-...

# Fallback provider (optional). If set, the harness fails over to OpenRouter
# when OpenAI is unreachable: first the same model via OpenRouter, then
# DeepSeek V3.1 Nex-N1 (nex-agi/deepseek-v3.1-nex-n1) as a cross-vendor last
# resort. Leave unset to disable fallback entirely.
OPENROUTER_API_KEY=sk-or-...
